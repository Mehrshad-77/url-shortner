# Local development only — replace these values for any deployed environment.
POSTGRES_DB=url_shortener
POSTGRES_USER=url_shortener
POSTGRES_PASSWORD=url_shortener_password

# Docker Compose uses the hostname "db" to reach PostgreSQL.
COMPOSE_DATABASE_URL=postgresql+psycopg://url_shortener:url_shortener_password@db:5432/url_shortener
COMPOSE_TEST_DATABASE_URL=postgresql+psycopg://url_shortener:url_shortener_password@db:5432/url_shortener_test

# Generate a private, random secret for your local .env file.
JWT_SECRET_KEY=replace-with-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
